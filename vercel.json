{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "functions": {
    "api/chat.mjs": {
      "maxDuration": 30
    }
  },
  "redirects": [],
  "rewrites": [
    {
      "source": "/blog/preview/:token",
      "destination": "/blog/preview"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/article"
    }
  ],
  "cleanUrls": true
}