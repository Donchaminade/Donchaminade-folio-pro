{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://donchamfolio.grosbit.com/admin/login.php",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://donchamfolio.grosbit.com/admin/login.php",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://donchamfolio.grosbit.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
