{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://donchamfolio.grosbit.com/admin/login.php",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://donchamfolio.grosbit.com/admin/login.php",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://donchamfolio.grosbit.com/admin/:path*",
      "permanent": false
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
