{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "rewrites": [
    {
      "source": "/blog/preview/:token",
      "destination": "/blog/preview.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/article.html"
    }
  ],
  "cleanUrls": true
}