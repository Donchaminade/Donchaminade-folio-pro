{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "functions": {
    "api/chat.mjs": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://donchamfolio.grosbit.com/admin/login.php",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://donchamfolio.grosbit.com/admin/login.php",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://donchamfolio.grosbit.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog/preview/:token",
      "destination": "/blog/preview"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/article"
    }
  ],
  "cleanUrls": true
}