# Copier en .env — voir README.md (section Installation locale)

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/donchaminade-d%C3%A9veloppeur-web
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_donchaminade
DB_USER=root
DB_PASS=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Compte admin (jamais commiter le mot de passe). Min. 12 caractères.
# Si défini, créé / mis à jour à la connexion admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# Jeton pour POST/GET /api/catalog-sync.php (migrations + catalogues)
CATALOG_SYNC_TOKEN=

# Vide en local (proxy Vite). En prod Vercel → URL Hostinger
VITE_API_URL=

SESSION_NAME=portfolio_admin_session

# Notifications push admin (php database/generate-vapid-keys.php après composer install)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:chaminade.dondah.adjolou@gmail.com

# Notifications email admin (événements publics : contact, collab, témoignage, reco, commentaire)
# Destinataire : NOTIFY_EMAIL → ADMIN_EMAIL → users.email → site_profile.email
NOTIFY_EMAIL=
NOTIFY_EMAIL_ENABLED=true
NOTIFY_EMAIL_DRY_RUN=false

# SMTP Hostinger (recommandé). Ex. smtp.hostinger.com / 465 / ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Portfolio Donchaminade
SMTP_TIMEOUT=12

# Si SMTP n’est pas renseigné, fallback sur PHP mail() (documenté ci-dessous)
MAIL_FALLBACK=true
