# Copier en .env — voir README.md (section Installation locale)

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/donchaminade-d%C3%A9veloppeur-web
FRONTEND_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_donchaminade
