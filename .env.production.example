# ═══════════════════════════════════════════════════════════
# PRODUCTION — Hostinger + Vercel
# Chemin serveur : /home/u878418868/domains/grosbit.com/public_html/donchamfolio
# URL API        : https://donchamfolio.grosbit.com
# ═══════════════════════════════════════════════════════════

# --- Hostinger : fichier .env à la racine de donchamfolio/ ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://donchamfolio.grosbit.com

# URL exacte du front Vercel (sans slash final)
FRONTEND_URL=https://donchaminade-alpha.vercel.app

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

CORS_ORIGINS=https://donchaminade-alpha.vercel.app,https://donchaminade-chaminadegithubs-projects.vercel.app,https://donchaminade-git-master-chaminadegithubs-projects.vercel.app

# Compte admin Hostinger — renseigner dans le .env serveur uniquement
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur
CATALOG_SYNC_TOKEN=
SESSION_NAME=portfolio_admin_session
VAPID_SUBJECT=mailto:chaminade.dondah.adjolou@gmail.com

# Notifications push admin (obligatoire pour recevoir sur téléphone)
# Générer : npx web-push generate-vapid-keys
# ou       : php database/generate-vapid-keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Notifications email (obligatoires pour les alertes contact / avis / commentaires)
# Destinataire : NOTIFY_EMAIL → ADMIN_EMAIL → email du profil
NOTIFY_EMAIL=
NOTIFY_EMAIL_ENABLED=true
NOTIFY_EMAIL_DRY_RUN=false

# SMTP Hostinger (hPanel → Emails → compte → SMTP)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Portfolio Donchaminade
SMTP_TIMEOUT=12

# Sans SMTP : PHP mail() Hostinger (moins fiable, à tester)
MAIL_FALLBACK=true

# --- Vercel : Environment Variables ---
# VITE_API_URL=https://donchamfolio.grosbit.com
# VITE_SITE_URL=https://donchaminade-alpha.vercel.app
# VITE_OG_IMAGE=https://donchaminade-alpha.vercel.app/image.png
# (optionnel — par défaut : VITE_SITE_URL + /image.png depuis public/)
#
# Chatbot (projet Vercel « donchaminade ») — coller UNE clé gratuite, jamais dans Git :
# GROQ_API_KEY=           # console.groq.com — openai/gpt-oss-20b (défaut)
# GROQ_MODEL=openai/gpt-oss-20b
# GOOGLE_GENERATIVE_AI_API_KEY=   # aistudio.google.com — Gemini Flash
# PORTFOLIO_API_URL=https://donchamfolio.grosbit.com
# Sans clé : le widget répond quand même via les faits publics (fallback).
